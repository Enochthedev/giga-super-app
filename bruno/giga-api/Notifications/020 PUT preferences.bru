meta {
  name: PUT preferences
  type: http
  seq: 20
}

put {
  url: {{baseUrl}}/api/v1/preferences
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email_enabled": true,
    "push_enabled": true
  }
}

tests {
  test("responds", function(){ expect(res.status).to.be.below(500); });
}

