meta {
  name: Estimate Fare
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/rides/estimate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "pickup_lat": 6.5244,
    "pickup_lng": 3.3792,
    "dropoff_lat": 6.4281,
    "dropoff_lng": 3.4219,
    "vehicle_type": "standard"
  }
}

tests {
  test("200", function(){ expect(res.status).to.equal(200); });
}

docs {
Fare estimate. vehicle_type: standard|premium|suv.
**Sample response** `data`: distance_km, duration_minutes, base_fare, estimated_total, currency:"NGN".
}
