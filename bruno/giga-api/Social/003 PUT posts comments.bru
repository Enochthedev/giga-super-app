put {
  url: {{baseUrl}}/api/v1/posts/{{postId}}/comments/:commentId
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "content": "Nice!"
  }
}

tests {
  test("responds", function(){ expect(res.status).to.be.below(500); });
}

