meta {
  name: Create Post
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/posts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "content": "My first Bruno post",
    "visibility": "public"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.id) bru.setEnvVar("postId", res.body.data.id);
}

tests {
  test("201", function(){ expect(res.status).to.equal(201); });
}

docs {
Creates a post and stores its id in `{{postId}}`.

visibility: `public` | `friends` | `private`. Optional: `media_urls[]`, `location{latitude,longitude,name}`, `feeling_activity`, `tagged_users[]`.
}
