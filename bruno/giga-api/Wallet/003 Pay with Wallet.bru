meta {
  name: Pay with Wallet
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/wallet/pay
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "amount": 500,
    "reference": "order-123"
  }
}

tests {
  test("responds", function(){ expect(res.status).to.be.below(500); });
}

docs {
