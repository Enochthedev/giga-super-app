meta {
  name: Forgot Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{customerEmail}}"
  }
}

docs {
Sends a recovery OTP email. NOTE: GoTrue rejects `.test` domains (400 email_address_invalid) — use a real email.
}
