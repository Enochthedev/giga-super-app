meta {
  name: Change Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "current_password": "{{password}}",
    "new_password": "NewPass!2026"
  }
}

docs {
Changes the password for the logged-in user (verifies current_password).
}
