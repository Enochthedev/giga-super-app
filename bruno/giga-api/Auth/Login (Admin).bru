meta {
  name: Login (Admin)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.body && res.body.access_token) {
    bru.setEnvVar("adminToken", res.body.access_token);
  }
}

tests {
  test("200 + token", function(){ expect(res.status).to.equal(200); });
}

docs {
Logs in the QA admin (DOP national) and stores the token into `{{adminToken}}` for the Admin folder.
}
