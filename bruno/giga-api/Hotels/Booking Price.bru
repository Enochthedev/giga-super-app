meta {
  name: Booking Price
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/bookings/price
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "hotelId": "{{hotelId}}",
    "roomTypeId": "{{roomTypeId}}",
    "checkInDate": "2026-08-01",
    "checkOutDate": "2026-08-03",
    "numberOfRooms": 1,
    "guestCount": 2
  }
}

docs {
Quote a booking price. NOTE: this endpoint accepts camelCase only.
}
