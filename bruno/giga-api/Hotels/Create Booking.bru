meta {
  name: Create Booking
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/bookings/create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "hotelId": "{{hotelId}}",
    "roomTypeId": "{{roomTypeId}}",
    "checkInDate": "2026-08-01",
    "checkOutDate": "2026-08-03",
    "numberOfRooms": 1,
    "guestCount": 2,
    "guestName": "QA Tester",
    "guestEmail": "{{customerEmail}}",
    "guestPhone": "+2348000000000"
  }
}

script:post-response {
  try { bru.setEnvVar("bookingId", res.body.data.booking.id); } catch(e){}
}

tests {
  test("200", function(){ expect(res.status).to.equal(200); });
}

docs {
Creates a booking (accepts camel or snake case). Stores bookingId.
}
