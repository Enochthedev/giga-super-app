meta {
  name: POST reviews
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/api/v1/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "hotel_id": "{{hotelId}}",
    "rating": 5,
    "title": "Great",
    "comment": "Loved it"
  }
}

tests {
  test("responds", function(){ expect(res.status).to.be.below(500); });
}

docs {
