post {
  url: {{baseUrl}}/api/v1/bookings/create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "hotelId": "{{hotelId}}",
    "roomTypeId": "{{roomTypeId}}",
    "checkInDate": "2026-09-01",
    "checkOutDate": "2026-09-03",
    "numberOfRooms": 1,
    "guestCount": 2,
    "guestName": "QA",
    "guestEmail": "{{customerEmail}}",
    "guestPhone": "+2348000000000"
  }
}

tests {
  test("responds", function(){ expect(res.status).to.be.below(500); });
}

