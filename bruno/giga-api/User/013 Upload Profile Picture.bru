meta {
  name: Upload Profile Picture
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/users/profile/picture
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  file: @file(/absolute/path/to/avatar.png)
}

tests {
  test("responds", function(){ expect(res.status).to.be.below(500); });
}

docs {
`upload-profile-picture` edge fn. multipart field `file` (jpeg/png/webp <=5MB). Read back at User → Get Profile (data.profile.avatar_url). Verified 200 in QA.
}
