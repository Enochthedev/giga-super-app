meta {
  name: Add Address
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/users/address
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "label": "Home",
    "name": "QA",
    "phone": "+2348000000000",
    "address_line1": "1 Test St",
    "city": "Lagos",
    "state": "Lagos",
    "country": "Nigeria"
  }
}

tests {
  test("responds", function(){ expect(res.status).to.be.below(500); });
}

docs {
`add-user-address`. POST adds; GET /api/v1/user/addresses lists (fixed E9).
}
