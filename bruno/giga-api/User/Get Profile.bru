meta {
  name: Get Profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/user/profile
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("200", function(){ expect(res.status).to.equal(200); });
}

docs {
Returns the user's profile.

**Sample response** `data.profile` includes `avatar_url`, `first_name`, `region_id`, etc.
}
