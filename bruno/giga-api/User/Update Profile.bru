meta {
  name: Update Profile
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/users/profile/update
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "bio": "Hello from Bruno",
    "first_name": "QA"
  }
}

docs {
Updates profile fields. JSON only. `body_weight`/`height` must be numbers; `areas_of_interest` an array; `date_of_birth` YYYY-MM-DD.
}
