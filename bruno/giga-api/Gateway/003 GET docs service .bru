meta {
  name: GET docs service 
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/docs/:service/*
  body: none
  auth: bearer
}

params:path {
  service: admin
}

auth:bearer {
  token: {{token}}
}

tests {
  test("2xx", function(){ expect(res.status).to.be.within(200,299); });
}

docs {
  `GET /docs/:service/*`
  
  **✅ verified 2xx** — last verified 2026-08-18, HTTP `200`.
  
  Service: **api-gateway** · file: `api-gateway/src/routes/docs.ts`
  Auth: customer bearer (`{{token}}`).
  
  **Sample response**
  ```json
  
