meta {
  name: Initialize Payment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/payments/initialize
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "moduleType": "hotel_booking",
    "referenceId": "{{bookingId}}",
    "amount": 70000,
    "paymentMethod": "card"
  }
}

tests {
  test("200", function(){ expect(res.status).to.equal(200); });
}

docs {
Server-authoritative payment init (Node payment-queue-service, currently mock).
moduleType ∈ {hotel_booking, ecommerce_order, taxi_ride}. Provider chosen by region currency.
}
