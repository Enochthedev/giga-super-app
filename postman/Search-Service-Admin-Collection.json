{
  "info": {
    "name": "Search Service - Admin API",
    "description": "Admin search endpoints for the Giga platform Search Service.\n\nSupports both GET and POST methods.\n\n**Authentication**: All endpoints require Bearer token.\n\n**Roles**:\n- Moderator: users, vendors, bookings, orders\n- Admin: drivers, transactions, rides\n\nBase URL: `{{baseUrl}}/api/v1/search/admin`",
    "version": "2.4.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3004", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Search Users (GET)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/search/admin/users?query=john&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search", "admin", "users"],
              "query": [
                { "key": "query", "value": "john" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Search users with GET request (dashboard compatible)"
          }
        },
        {
          "name": "Search Users - All (GET)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/search/admin/users?page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search", "admin", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "Get all users without filter"
          }
        },
        {
          "name": "Search Users (POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"q\": \"john\",\n  \"is_active\": true,\n  \"page\": 1,\n  \"limit\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/search/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search", "admin", "users"]
            },
            "description": "Search users with POST request"
          }
        }
      ]
    },
