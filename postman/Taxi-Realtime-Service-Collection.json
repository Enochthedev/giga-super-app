              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{bearerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rides/{{testRideId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rides", "{{testRideId}}", "accept"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driver_eta_minutes\": 5\n}"
            },
            "description": "Driver accepts a ride request.\n\nOnly verified drivers can accept rides.\n\nRide must be in 'requested' status."
          },
          "response": [
            {
              "name": "Ride Accepted",
              "status": "OK",
