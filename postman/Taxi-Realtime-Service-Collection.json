            "url": {
              "raw": "{{baseUrl}}/api/rides/{{testRideId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rides", "{{testRideId}}", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"arrived\",\n  \"cancellation_reason\": null\n}"
            },
            "description": "Update ride status.\n\nValid statuses: accepted, arrived, picked_up, in_progress, completed, cancelled, no_show\n\nInclude cancellation_reason when status is 'cancelled'."
          },
          "response": [
            {
              "name": "Status Updated",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"ride-uuid\",\n    \"status\": \"arrived\",\n    \"updated_at\": \"2026-02-20T10:35:00Z\"\n  }\n}"
            },
            {
