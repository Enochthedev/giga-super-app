    },
    {
      "name": "Drivers",
      "description": "Driver management endpoints - profile, availability, location, and earnings",
      "item": [
        {
          "name": "Get Driver Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "profile"]
            },
            "description": "Get the authenticated driver's profile.\n\nIncludes user profile information and vehicle details."
          },
          "response": [
            {
              "name": "Driver Profile",
              "status": "OK",
              "code": 200,
