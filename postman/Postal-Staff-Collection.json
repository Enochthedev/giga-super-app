                  "description": "Items per page"
                },
                {
                  "key": "staff_type",
                  "value": "postmaster",
                  "description": "Filter by staff type: postmaster, regional_manager, admin_staff",
                  "disabled": true
                },
                {
                  "key": "approval_status",
                  "value": "pending",
                  "description": "Filter by approval status: pending, approved, rejected",
                  "disabled": true
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{bearerToken}}" }]
