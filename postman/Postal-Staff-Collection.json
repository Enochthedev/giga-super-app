          "name": "Get All Postal Staff",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/postal/staff?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "postal", "staff"],
              "query": [
                {
                  "key": "page",
