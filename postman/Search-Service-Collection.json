{
  "info": {
    "name": "GIGA Search Service API",
    "description": "Search Service API for browsing hotels, products, and drivers.\n\nMost endpoints are PUBLIC (no auth required).\n\n**Demo Data Available**:\n- Hotels: Lekki, Ikeja, Sunrise, Mountain View, etc.\n- Products: iPhone, Kaftan, Sofa, Fitness Watch, etc.\n- Drivers: 8 verified drivers\n\nBase URL: `{{base_url}}`",
    "version": "2.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3004/api/v1/search" },
    { "key": "gateway_url", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Hotels - PUBLIC",
      "item": [
        {
          "name": "Search Hotels - Lagos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/hotels?q=Lagos&page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["hotels"],
              "query": [
                { "key": "q", "value": "Lagos" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Search hotels in Lagos (returns 5+ results)"
          }
        },
        {
          "name": "Search Hotels - Lekki",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/hotels?q=Lekki&page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["hotels"],
              "query": [
                { "key": "q", "value": "Lekki" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Search for Lekki Luxury Suites"
          }
        },
        {
          "name": "Search Hotels - All",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/hotels?page=1&limit=50",
              "host": ["{{base_url}}"],
              "path": ["hotels"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "Get all hotels (8 total)"
          }
        },
        {
          "name": "Search Hotels (POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/hotels",
              "host": ["{{base_url}}"],
              "path": ["hotels"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"q\": \"Lagos\",\n  \"star_rating\": 4,\n  \"page\": 1,\n  \"limit\": 20\n}"
            },
            "description": "Search 4+ star hotels in Lagos"
          }
        },
        {
          "name": "Get Popular Hotels",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/hotels/popular?limit=10",
              "host": ["{{base_url}}"],
              "path": ["hotels", "popular"],
              "query": [{ "key": "limit", "value": "10" }]
            },
            "description": "Get popular hotels sorted by rating"
          }
        },
        {
          "name": "Get Nearby Hotels - Lagos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/hotels/nearby?latitude=6.5244&longitude=3.3792&radius=50",
              "host": ["{{base_url}}"],
              "path": ["hotels", "nearby"],
              "query": [
                { "key": "latitude", "value": "6.5244" },
                { "key": "longitude", "value": "3.3792" },
                { "key": "radius", "value": "50" }
              ]
            },
            "description": "Find hotels near Lagos coordinates"
          }
        }
      ]
    },
