{
  "name": "@giga/shared",
  "version": "1.0.0",
  "description": "Shared utilities and configurations for Giga platform services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./observability": {
      "import": "./dist/observability/index.js",
      "types": "./dist/observability/index.d.ts"
    },
    "./types/database": {
      "import": "./types/database.js",
      "types": "./types/database.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sentry/node": "^7.99.0",
    "prom-client": "^15.1.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3"
  }
}
