    { "key": "baseUrl", "value": "http://localhost:3008", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" },
    { "key": "hotelId", "value": "", "type": "string" },
    { "key": "roomTypeId", "value": "", "type": "string" },
    { "key": "bookingId", "value": "", "type": "string" },
    { "key": "reviewId", "value": "", "type": "string" }
