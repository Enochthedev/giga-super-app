        {
          "name": "Search Hotels by Location",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/hotels/search?lat=6.5244&lng=3.3792&radius=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "hotels", "search"],
              "query": [
                { "key": "lat", "value": "6.5244" },
                { "key": "lng", "value": "3.3792" },
                { "key": "radius", "value": "25" }
