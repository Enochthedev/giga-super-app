        {
          "name": "Search Hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/hotels/search?city=Lagos&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "hotels", "search"],
              "query": [
                { "key": "city", "value": "Lagos" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "min_price", "value": "", "disabled": true },
                { "key": "max_price", "value": "", "disabled": true },
                { "key": "sort_by", "value": "rating", "disabled": true }
              ]
            }
          }
